# ─── Site ──────────────────────────────────────────────────────────────
# The public URL used for SEO is fixed in lib/site.ts (https://www.sehatone.co.in)
# Contact details shown in the footer and contact section
NEXT_PUBLIC_CONTACT_EMAIL=business@sehatone.co.in
NEXT_PUBLIC_CONTACT_PHONE=+91 00000 00000

# ─── Database (libSQL / Turso) ─────────────────────────────────────────
# Local development: leave unset to use a SQLite file at ./data/sehatone.db
# Production: create a Turso database and paste its URL + token here
# DATABASE_URL=libsql://sehatone-<your-org>.turso.io
# DATABASE_AUTH_TOKEN=

# ─── Email (Resend) ────────────────────────────────────────────────────
# Server-only. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
# Must use a domain verified in Resend (e.g. sehatone.co.in)
EMAIL_FROM=SEHATONE <noreply@sehatone.co.in>
# Where new inquiries are delivered (comma-separate multiple addresses)
BUSINESS_EMAIL=business@sehatone.co.in

# ─── Security ──────────────────────────────────────────────────────────
# Random string used to hash visitor IPs for rate limiting (no raw IPs are stored)
IP_HASH_SALT=change-me-to-a-long-random-string

# ─── SEO & analytics (optional, public) ───────────────────────────────
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Analytics loads only when set.
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification code (only the content="..." value).
# Not needed if you verify via DNS (recommended).
NEXT_PUBLIC_GSC_VERIFICATION=
